{
  "name": "nexly-api-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 0.0.0.0 --port 4174",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "docs:smoke": "node scripts/smoke-test.mjs",
    "docs:contract": "node --test scripts/openapi.test.mjs",
    "docs:motion": "node --test scripts/home-motion.test.mjs",
    "docs:assets": "node scripts/check-page-assets.mjs",
    "docs:phase2": "npm run docs:motion && npm run docs:assets",
    "docs:check": "npm run docs:contract && npm run docs:phase2 && npm run docs:smoke"
  },
  "devDependencies": {
    "@scalar/api-reference": "^1.64.1",
    "medium-zoom": "^1.1.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.41",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "gsap": "3.15.0"
  }
}
